# 복사해서 사용: cp .env.example .env
# docker compose와 로컬 실행이 같은 변수를 읽는다.

POSTGRES_USER=propredict
POSTGRES_PASSWORD=propredict
POSTGRES_DB=propredict
POSTGRES_PORT=5432

# 로컬(호스트)에서 ETL·학습을 돌릴 때 쓰는 접속 문자열.
# 컨테이너 안의 API는 docker-compose.yml에서 호스트명을 db로 덮어쓴다.
DATABASE_URL=postgresql+psycopg://propredict:propredict@localhost:5432/propredict

# 원본 CSV 위치. Kaggle zip을 풀면 archive/ 한 단계가 더 생길 수 있어 ETL이 자동 탐색한다.
RAW_DATA_DIR=data/raw

# 학습된 모델 산출물 위치 (API가 시작 시 1회 로드)
ARTIFACTS_DIR=artifacts

# 프론트엔드가 호출할 API 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
